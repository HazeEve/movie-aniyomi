          0.62
        ],
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "GlobalShadows": true,
        "ShadowSoftness": 0.25
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.28,
          "Offset": 0.12,
          "Color": [
            0.86,
            0.8,
            0.93
          ],
          "Decay": [
            0.93,
